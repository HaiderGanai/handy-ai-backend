{
  "info": {
    "name": "Handy AI \u2014 Phase 1 (Auth & User Profile)",
    "description": "Phase 1 endpoints: email OTP sign-up/sign-in, forgot/reset password, logout, and guarded user profile read/update/photo upload. See PHASE_1_NOTES.md for the flow explanation and PLAN.md/CLAUDE.md for project context.\n\nSet the `baseUrl` collection variable if your server isn't on the default. Run \"Sign In\" once to auto-populate `accessToken` for every guarded request below it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "resetToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "providerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/health",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "health"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"status\": \"ok\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"Jane Doe\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/sign-up",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "sign-up"
              ]
            },
            "description": "Creates an unverified user and emails a 5-digit OTP. Same email twice -> 409."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"message\": \"Verification code sent to your email!\"\n}"
            },
            {
              "name": "409 Conflict \u2014 email already registered",
              "status": "Conflict",
              "code": 409,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"message\": \"User Already Exists!\",\n  \"error\": \"Conflict\",\n  \"statusCode\": 409\n}"
            },
            {
              "name": "400 Bad Request \u2014 validation",
              "status": "Bad Request",
              "code": 400,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"message\": [\"email must be an email\"],\n  \"error\": \"Bad Request\",\n  \"statusCode\": 400\n}"
            }
          ]
        },
        {
          "name": "Verify OTP \u2014 Sign Up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// no token to capture here \u2014 signup verification doesn't log you in,",
                  "// it only flips isEmailVerified. Sign in separately afterward."
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"code\": \"12345\",\n  \"purpose\": \"SIGNUP\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-otp"
              ]
            },
            "description": "Replace `code` with whatever arrived by email. Wrong code, wrong purpose, or expired code all return the same generic error. More than 5 wrong attempts within 15 minutes locks out until a fresh code is requested (resend-otp)."
          },
          "response": [
            {
              "name": "201 Created \u2014 verified",
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"message\": \"Email verified successfully!\"\n}"
            },
            {
              "name": "400 Bad Request \u2014 wrong/expired code",
              "status": "Bad Request",
              "code": 400,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"message\": \"Invalid or Expired OTP!\",\n  \"error\": \"Bad Request\",\n  \"statusCode\": 400\n}"
            },
            {
              "name": "400 Bad Request \u2014 too many attempts",
              "status": "Bad Request",
              "code": 400,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"message\": \"Too many attempts. Please request a new code!\",\n  \"error\": \"Bad Request\",\n  \"statusCode\": 400\n}"
            }
          ]
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"purpose\": \"SIGNUP\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/resend-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "resend-otp"
              ]
            },
            "description": "Same response whether or not the email exists, or is already verified \u2014 no account enumeration. purpose can be SIGNUP or RESET_PASSWORD."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"message\": \"If an account exists, a verification code has been sent!\"\n}"
            }
          ]
        },
        {
          "name": "Sign In",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', body.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/sign-in",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "sign-in"
              ]
            },
            "description": "Must be verified first. Saves accessToken into the collection variable on success so the requests below work without manual copy-pasting."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"user\": {\n    \"id\": \"8f046014-901e-4794-8e89-310a90b18349\",\n    \"email\": \"jane@example.com\",\n    \"role\": \"CUSTOMER\",\n    \"isEmailVerified\": true,\n    \"fullName\": \"Jane Doe\",\n    \"address\": null,\n    \"postcode\": null,\n    \"photoUrl\": null,\n    \"householdNotes\": null,\n    \"createdAt\": \"2026-10-06T08:31:41.194Z\",\n    \"updatedAt\": \"2026-10-06T08:33:31.522Z\"\n  },\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\"\n}"
            },
            {
              "name": "401 Unauthorized \u2014 wrong password / no such user",
              "status": "Unauthorized",
              "code": 401,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"message\": \"Invalid credentials!\",\n  \"error\": \"Unauthorized\",\n  \"statusCode\": 401\n}"
            },
            {
              "name": "403 Forbidden \u2014 not verified yet",
              "status": "Forbidden",
              "code": 403,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"message\": \"Please verify your email first!\",\n  \"error\": \"Forbidden\",\n  \"statusCode\": 403\n}"
            }
          ]
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "forgot-password"
              ]
            },
            "description": "Same response whether or not the email is registered."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"message\": \"If an account exists, a verification code has been sent!\"\n}"
            }
          ]
        },
        {
          "name": "Verify OTP \u2014 Reset Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    if (body.resetToken) {",
                  "        pm.collectionVariables.set('resetToken', body.resetToken);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"code\": \"12345\",\n  \"purpose\": \"RESET_PASSWORD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-otp"
              ]
            },
            "description": "Replace `code` with the one emailed for the reset flow. On success this saves the one-time resetToken into the collection variable for the next request."
          },
          "response": [
            {
              "name": "201 Created \u2014 reset token issued",
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"message\": \"OTP verified!\",\n  \"resetToken\": \"f8ba460d303a524fc51b80ef18efa41031e2ac963db0d22f673c1acb69b86923\"\n}"
            }
          ]
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resetToken\": \"{{resetToken}}\",\n  \"newPassword\": \"newpassword456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "reset-password"
              ]
            },
            "description": "resetToken is single-use and expires 15 minutes after being issued. Also invalidates any existing session for that user."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"message\": \"Password reset successfully!\"\n}"
            },
            {
              "name": "400 Bad Request \u2014 invalid/expired token",
              "status": "Bad Request",
              "code": 400,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"message\": \"Invalid or Expired Reset Token!\",\n  \"error\": \"Bad Request\",\n  \"statusCode\": 400\n}"
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Deletes the session (DB row + Redis key) \u2014 the accessToken stops working immediately, before its JWT expiry."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"message\": \"Logged out successfully!\"\n}"
            }
          ]
        }
      ]
    },
