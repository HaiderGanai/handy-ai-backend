    {
      "name": "Provider",
      "description": "Needs a PROVIDER token: sign up with \"role\": \"PROVIDER\", verify, sign in (sets accessToken). Copy a category id from Catalog into categoryId.",
      "item": [
        {
          "name": "Onboarding",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/provider/onboarding",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
