NODE_ENV=development
PORT=3000

# Local Postgres/Redis run via `docker compose up -d` (see docker-compose.yml).
# Port 5433 (not 5432) because a system-wide Postgres already owns 5432 on this
# machine — this project gets its own isolated instance instead of sharing that one.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=handy_ai
POSTGRES_PORT=5433
DATABASE_URL=postgres://postgres:postgres@localhost:5433/handy_ai

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me
# seconds, not a duration string — also used as the session's Redis/DB TTL
JWT_EXPIRES_IN=86400

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Handy AI <no-reply@handyai.app>"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
